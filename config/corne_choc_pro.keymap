/*
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 *
 * Neo2, host-driven. The firmware sends US-positional keycodes and the host
 * layout de(neo) turns them into Neo2. Requires the host on layout "de",
 * variant "neo".
 *
 * Neo's modifiers are sent as the keys de(neo) expects them on:
 *   CAPS        Mod3 left  (symbols)
 *   BSLH        Mod3 right (<BKSL>), on the outer home key like on a Neo board
 *   NON_US_BSLH Mod4       (<LSGT>, navigation/numpad)
 * Mod3 + Mod4 together, or with Shift, reach the Greek and math levels.
 *
 * The settings layer also carries what Neo keeps on the number row, which the
 * Corne lacks: LS(N7) is Shift + <AE07>, which de(neo) renders as €.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // Rendered by de(neo):
        //   Tab   x v l c w   Esc  Super  k h g f q  ß
        //   M3    u i a e o   Alt   Alt   s n r t d  M3
        //   Shift ü ö ä p z               b m , . j  Shift
        //              Ctrl M4 Space    Bksp y Enter
        // y moves to the thumb: Neo needs a 7th column on the right for y and Mod3.
        // Hold Esc for the settings layer. Alt is on both halves so Alt + letter
        // can use the other hand; both send left Alt because right Alt is Mod4.
        base {
            display-name = "NEO2";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T    &lt 1 ESC  &kp LGUI   &kp Y  &kp U  &kp I      &kp O    &kp P     &kp LBKT
&kp CAPS   &kp A  &kp S  &kp D  &kp F  &kp G    &kp LALT   &kp LALT   &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp BSLH
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B                          &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                  &kp LCTRL  &kp NON_US_BSLH  &kp SPACE               &kp BSPC  &kp SQT   &kp RET
            >;
        };

        // Left: media, Bluetooth, bootloader, Studio unlock.
        // Right, rendered by de(neo): ° § ℓ » « — / € „ “ ” / dead ^ ` ´
        settings {
            display-name = "SETTINGS";
            bindings = <
&trans  &kp C_MUTE    &kp C_VOL_DN     &kp C_VOL_UP  &kp C_PP      &trans          &trans     &trans     &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(MINUS)
&trans  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans     &trans     &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &trans      &trans
&trans  &bt BT_CLR    &rgb_ug RGB_TOG  &sys_reset    &bootloader   &studio_unlock                        &kp GRAVE   &kp EQUAL   &kp RBKT    &trans      &trans      &trans
                                       &trans        &trans        &trans                                &trans      &trans      &trans
            >;
        };
    };
};
